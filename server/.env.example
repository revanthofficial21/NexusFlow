# Copy to server/.env. This file is a template: never put real credentials in it.
PORT=5000

# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexusflow
# URL-encode the password if it contains @ : / or #
MONGODB_URI=mongodb://localhost:27017/nexusflow

# Comma separated. Both loopback spellings, because Vite prints both.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Max points accepted by POST /api/telemetry/batch
INGEST_BATCH_LIMIT=2000

# Applied when the time-series collection is first created. Changing it later has
# no effect on an existing collection.
TELEMETRY_RETENTION_DAYS=30

# Minimum gap between two alerts from the same rule. Without this a rule fires on
# every matching point and floods the alerts collection.
ALERT_COOLDOWN_MS=30000

# Minimum gap between two edge:activity events for the same wire. The canvas only
# needs "data is flowing here", not one message per value.
EDGE_ACTIVITY_INTERVAL_MS=100

# SMS provider for the sms node: "log" records and succeeds, "fail" simulates an
# outage. Swap services/smsProvider.js for a real provider when one is available.
SMS_PROVIDER=log
